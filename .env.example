# Base URL del sitio. En Vercel se define como variable de entorno.
# Ejemplo: https://instalaciones-electricas.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Endpoint del formulario. Opciones:
#   - Formspree: https://formspree.io/f/TU_ID
#   - API propia:  https://tu-dominio/api/contacto
# Si queda vacío, el formulario deriva a WhatsApp con los datos precargados.
NEXT_PUBLIC_FORM_ENDPOINT=""

# Dominio del email de contacto. Dejar vacío hasta confirmarlo.
NEXT_PUBLIC_CONTACT_EMAIL=""